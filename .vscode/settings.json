{
    // --- Cellules (Databricks + standard "# %%") ---
    "jupyter.interactiveWindow.cellMarker.codeRegex": "^# COMMAND ----------|^# Databricks notebook source|^(#\\s*%%|#\\s*\\<codecell\\>|#\\s*In\\[\\d*?\\]|#\\s*In\\[ \\])",
    "jupyter.interactiveWindow.cellMarker.default": "# %%",

    // --- Identité visuelle (violet) ---
    "workbench.colorCustomizations": {
        "activityBar.background": "#5B3A9E",
        "activityBar.foreground": "#ffffff",
        "activityBar.inactiveForeground": "#ffffff99",
        "titleBar.activeBackground": "#5B3A9E",
        "titleBar.activeForeground": "#ffffff",
        "titleBar.inactiveBackground": "#5B3A9E",
        "titleBar.inactiveForeground": "#ffffff99"
    },

    // --- Python ---
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
    "python.terminal.activateEnvironment": false,
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": ["tests"],

    // --- Format / lint (Ruff remplace black, isort, flake8) ---
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "notebook.formatOnSave.enabled": true,
    "[json][jsonc][yaml][markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },

    // --- Notebooks ---
    "notebook.diff.ignoreOutputs": true,
    "notebook.output.textLineLimit": 50,
    "jupyter.askForKernelRestart": false,
    "jupyter.interactiveWindow.textEditor.executeSelection": true,

    // --- Hygiène de fichiers ---
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "editor.rulers": [88],
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/.ipynb_checkpoints": true
    },
    "search.exclude": {
        "**/.venv": true,
        "**/*.lock": true
    },
    "git.autofetch": true,
    // --- Fin de ligne ---
    "files.eol": "\n",

    // --- Copilot : messages de commit ---
    "github.copilot.chat.commitMessageGeneration.instructions": [
        {
            "text": "Rédige le message de commit selon la spécification Conventional Commits : <type>(<portée optionnelle>): <description>. Types autorisés : feat, fix, docs, style, refactor, perf, test, build, ci, chore. Description à l'impératif, en minuscules, sans point final, 72 caractères maximum. Ajoute un corps seulement si nécessaire, séparé par une ligne vide. Écris en français."
        }
    ]
}
